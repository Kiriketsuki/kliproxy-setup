# Hub settings. Copy this file to hub.env and set your values. No secret belongs here.
# To move the hub to a new host, change HUB_SSH, HUB_DIR and HUB_FQDN, then run deploy.sh.

# SSH target of the hub host: an alias from ~/.ssh/config, or user@hostname.
HUB_SSH="my-hub-host"
# Directory on the hub host that holds the whole hub.
HUB_DIR="/srv/claude-hub"
# Tailnet name that the clients use to reach the hub host.
HUB_FQDN="my-hub-host.example-tailnet.ts.net"
# Container image. Pin a tag. Do not use latest.
HUB_IMAGE="eceasy/cli-proxy-api:v8.0.67"
# Pools and their ports. One proxy process serves one pool.
# The pool names must match the services in remote/compose.yaml.
HUB_POOLS="personal:8317 work:8318"
# Port of the read-only status endpoint that the router serves.
HUB_STATUS_PORT="8319"
# Commands on the hub host. Give full paths if sudo does not find them.
# Synology DSM example:
#   HUB_DOCKER="/usr/local/bin/docker"
#   HUB_TAILSCALE="/usr/local/bin/tailscale --socket=/var/run/tailscale/tailscaled.sock"
HUB_DOCKER="docker"
HUB_TAILSCALE="tailscale"
# Client directory for the access keys and URLs.
HUB_KEY_DIR="$HOME/.config/cliproxy"
